# Copia este archivo a ".streamlit/secrets.toml" y completa tus credenciales reales.
# El archivo secrets.toml está en .gitignore y NO debe subirse al repositorio.

# Opción A (recomendada): Vertex AI, con cuota dedicada de un proyecto GCP.
# Pega aquí el contenido del JSON del service account como tabla TOML:
# [gcp_service_account]
# type = "service_account"
# project_id = "tu-proyecto-gcp"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "cuenta@tu-proyecto-gcp.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# universe_domain = "googleapis.com"

# Opcional: región de Vertex AI (por defecto "global")
# VERTEX_LOCATION = "global"

# Opción B (respaldo): API key de AI Studio / Gemini Developer API.
# Se usa automáticamente si no hay credenciales de Vertex AI configuradas.
GEMINI_API_KEY = "tu_api_key_de_gemini_aqui"
